# Сервер моделей: любой OpenAI-совместимый.
# Ниже — Ollama, на ней снят отчёт docs/report.md (ollama pull qwen2.5:1.5b-instruct).
# Для LM Studio поменяйте адрес на http://localhost:1234/v1 и имена моделей на свои.
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
# Основная модель — генерация карточки
LLM_MODEL=qwen2.5:1.5b-instruct
# Дешёвая модель — служебные вызовы: детектор инъекций, судья метрик.
# Отдельная запись, а не та же самая: экономию видно в таблице вызовов
LLM_MODEL_CHEAP=qwen2.5:1.5b-instruct
# Маленькая модель на процессоре думает долго — таймаут с запасом
LLM_TIMEOUT_S=180

# База. PG_PORT читает docker-compose; поменяйте, если 5433 занят
PG_PORT=5433
DATABASE_URL=postgresql://card:card@localhost:5433/card

# Движок устойчивого исполнения. TEMPORAL_PORT и TEMPORAL_UI_PORT читает docker-compose
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8233
TEMPORAL_HOST=localhost:7233
TEMPORAL_TASK_QUEUE=card-queue

# Эмбеддинги. Модель скачивается с Hugging Face при первом запуске.
# embeddinggemma закрыта лицензией: нужен принятый доступ и HF_TOKEN.
# Открытая замена той же размерности — intfloat/multilingual-e5-base
EMBED_MODEL=intfloat/multilingual-e5-base
EMBED_DIM=768
EMBED_DEVICE=cpu

# Поиск
RETRIEVAL_TOP_K=5
# Порог привязан к модели эмбеддингов, см. docs/adr/0003
RETRIEVAL_THRESHOLD=0.81

# Защита: сколько подозрительных фрагментов документ переживает без человека
SUSPICIOUS_CHUNK_LIMIT=2
